# ============================================================================
# JARVIS ASSISTANT - Configuração de Ambiente (.env.example)
# Copie este arquivo para ".env" na raiz do projeto:
#   copy .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Inteligência Artificial Local (Ollama & Qwen 3.5)
# ----------------------------------------------------------------------------
# URL do servidor local do Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# Modelo principal com suporte nativo a Tool Calling
OLLAMA_MODEL=qwen3.5:9b

# Janela de contexto (CRÍTICO: manter em 8192 para respeitar o orçamento de 8 GB de VRAM)
OLLAMA_NUM_CTX=8192

# Ativa/desativa o modo de raciocínio estendido (<think>) do Qwen (false = menor latência)
OLLAMA_THINK=false

# Quantidade máxima de mensagens mantidas na janela deslizante de memória
MAX_MEMORY_MESSAGES=20

# ----------------------------------------------------------------------------
# 2. Telemetria de Hardware & Proteção de Performance (Modo Jogo)
# ----------------------------------------------------------------------------
# Uso percentual da GPU (RTX 4060 Ti) acima do qual tarefas pesadas em background são pausadas
GPU_GAMING_THRESHOLD=85.0

# Limiar de alerta de temperatura da GPU em graus Celsius (°C)
GPU_TEMP_ALERT_THRESHOLD=80.0

# Limiar de alerta de temperatura da CPU (Ryzen 5 5600 via MSI Afterburner) em graus Celsius (°C)
CPU_TEMP_ALERT_THRESHOLD=85.0

# Intervalo de atualização da telemetria em segundos
TELEMETRY_INTERVAL_SECONDS=2.0

# ----------------------------------------------------------------------------
# 3. Integração Física - Arduino UNO (Comunicação Serial USB)
# ----------------------------------------------------------------------------
# Porta serial atribuída ao Arduino UNO no Gerenciador de Dispositivos do Windows
COM_PORT=COM3

# Taxa de transmissão serial (deve coincidir com Serial.begin no sketch do Arduino)
BAUD_RATE=9600

# Timeout de leitura/escrita da porta serial em segundos
SERIAL_TIMEOUT=1.0

# Intervalo de alternância das telas do LCD 1602A em segundos
LCD_REFRESH_INTERVAL_SECONDS=3.5

# ----------------------------------------------------------------------------
# 4. Triagem Inteligente de E-mails (IMAP)
# ----------------------------------------------------------------------------
# Servidor e porta IMAP (ex: Gmail requer Senha de App com 2FA ativo)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Credenciais da conta de e-mail monitorada
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_aqui

# Intervalo de verificação de novos e-mails não lidos em segundos
EMAIL_CHECK_INTERVAL_SECONDS=60
